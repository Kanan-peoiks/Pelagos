# Copernicus Data Space Ecosystem — client credentials
# Obtain from: https://dataspace.copernicus.eu/
# Copy this file to .env.local and fill in real values.
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# Sentinel Hub Configuration Instance ID (from the Configuration Utility
# dashboard) — not used by any code yet, reserved for future SAR image fetching.
COPERNICUS_INSTANCE_ID=

# FastAPI backend (see backend/). Local dev: http://localhost:8000
# Production (Vercel): the deployed Render URL, e.g. https://seasentry-api.onrender.com
BACKEND_URL=
