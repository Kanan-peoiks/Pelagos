# Copy to .env for local development (never commit the real .env).

# Local dev default: a SQLite file, zero setup required.
# Production (Render): set this to your Supabase/Neon/Render Postgres
# connection string, e.g. postgresql://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///./seasentry.db

# Generate a real secret for production, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=dev-only-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma-separated list of allowed frontend origins.
# Include your Vercel production URL and any preview-deployment domains.
CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# Comma-separated emails auto-promoted to role="admin" on register/login —
# the bootstrap mechanism for the first admin account. Leave blank to skip.
ADMIN_EMAILS=

# Gmail SMTP for password-reset and feedback emails — an app password, not
# your account password (requires 2-Step Verification; generate at
# myaccount.google.com/apppasswords). Leave blank to skip sending — emails
# are logged instead, so the flow still works end-to-end for local testing.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Used to build the link inside password-reset emails.
FRONTEND_URL=http://localhost:3000

# Requires an admin login to also pass a 6-digit emailed code (see
# routers/auth.py's _send_two_factor_challenge). Defaults to false since it
# depends on SMTP above being reachable — only turn this on once that's
# confirmed working, so a broken email sender can never lock admins out.
REQUIRE_ADMIN_2FA=false

# Slack "Incoming Webhook" URL — posts an alert whenever a new HIGH-risk
# incident is created (see slack_util.py). Create one at
# https://api.slack.com/apps > your app > Incoming Webhooks. Leave blank to
# skip sending.
SLACK_WEBHOOK_URL=

# Copernicus Data Space Ecosystem OAuth client (dataspace.copernicus.eu ->
# Sentinel Hub -> OAuth clients) — used by app/satellite.py to fetch real
# Sentinel-1 SAR tiles for POST /detect. Leave blank and /detect returns a
# clear 502 instead of faking a result.
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# aisstream.io free API key — real AIS vessel positions (app/ais.py,
# GET /vessels/live). Get one at https://aisstream.io/. Unset = that
# endpoint returns a clear 502 instead of faking data.
AISSTREAM_API_KEY=
