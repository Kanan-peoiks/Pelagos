# Copy to .env for local development (never commit the real .env).

# Local dev default: a SQLite file, zero setup required.
# Production (Render): set this to your Supabase/Neon/Render Postgres
# connection string, e.g. postgresql://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///./seasentry.db

# Generate a real secret for production, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=dev-only-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma-separated list of allowed frontend origins.
# Include your Vercel production URL and any preview-deployment domains.
CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app
